{
  "name": "sticker-maker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser-based WhatsApp & Telegram sticker maker. Images and video in, spec-compliant stickers out.",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/sync-ffmpeg-core.mjs",
    "prebuild": "node scripts/sync-ffmpeg-core.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "node scripts/sync-ffmpeg-core.mjs",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm run test && npm run test:e2e",
    "sync:ffmpeg": "node scripts/sync-ffmpeg-core.mjs"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
